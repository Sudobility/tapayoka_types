{
  "name": "@sudobility/tapayoka_types",
  "version": "0.0.59",
  "description": "TypeScript types for Tapayoka - QR-to-device cashless payment system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "dev": "bunx tsc --watch",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "lint:fix": "bunx eslint src/ --fix",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "typescript",
    "types",
    "tapayoka",
    "cashless",
    "payment",
    "ble",
    "iot"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/types": "^1.9.76"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/types": "^1.9.76",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~16.5.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/tapayoka_types.git"
  }
}
